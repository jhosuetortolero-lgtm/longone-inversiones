# Public URL the site will be served from (used for canonical, hreflang, sitemap, Open Graph).
VITE_SITE_URL=https://longoneinversiones.com.br

# Contact integration — leave empty until Longone provides official endpoints/contacts.
# HTTPS endpoint that accepts a JSON POST of the inquiry form (CRM webhook, Formspree, etc.).
VITE_CONTACT_ENDPOINT=
# WhatsApp number that receives the inquiry form, digits only with country code.
# Default (src/data/site.ts): 5581996846263 — supplied by the project owner on 2026-11-24.
VITE_CONTACT_WHATSAPP=
# Official e-mail address for inquiries.
VITE_CONTACT_EMAIL=
