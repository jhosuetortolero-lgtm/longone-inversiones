{
  "name": "longone-inversiones",
  "private": true,
  "version": "1.0.0",
  "description": "Longone Inversiones Inmobiliárias — cinematic redesign proposal (ES / PT-BR)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "check:routes": "node scripts/check-routes.mjs",
    "frames": "node scripts/extract-frames.mjs",
    "images": "python scripts/optimize-images.py .",
    "logo": "python scripts/process-logo.py ."
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.6",
    "gsap": "^3.13.0",
    "lenis": "^1.3.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  }
}
